# Azure Translator Configuration
# Uses Entra ID authentication - no API key needed
TRANSLATOR_ENDPOINT=https://xxxxx.cognitiveservices.azure.com/

# Azure Storage Configuration using Entra ID (Managed Identity)
# No SAS tokens needed - authentication uses DefaultAzureCredential
STORAGE_ACCOUNT_URL=https://xxxxxx.blob.core.windows.net
INPUT_CONTAINER=xxxxxx
OUTPUT_CONTAINER=xxxxxx

# Authentication:
# - Local development: Uses Azure CLI login (run 'az login' first)
# - Azure deployment: Uses Managed Identity
#
# Required RBAC roles:
# - Storage account: Storage Blob Data Contributor
# - Translator resource: Cognitive Services User
